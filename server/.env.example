# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/jansamadhan

# JWT Secret (use a long random string in production)
JWT_SECRET=your_super_secret_jwt_key_here

# Initial Administrator Account Seed (Backend server-side only)
ADMIN_EMAIL=admin@jansamadhan.gov.in
ADMIN_PASSWORD=your_secure_admin_password_here

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional AI Categorization Provider (Google Gemini or OpenAI)
# If left empty, JanSamadhan uses its intelligent built-in Civic NLP semantic analyzer
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Notification Channels (In-app MongoDB notifications are always enabled)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMS_ENABLED=false
SMS_API_KEY=
